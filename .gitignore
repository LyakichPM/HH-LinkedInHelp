# ============================================================
# РЕПОЗИТОРИЙ ПУБЛИЧНЫЙ. Модель защиты - БЕЛЫЙ СПИСОК.
#
# Всё в корне закрыто по умолчанию (`/*`), открывается только то, что явно
# перечислено ниже. Так новый разовый скрипт, дамп вакансии, письмо или
# скриншот НЕ утекут просто потому, что под них не написали правило.
#
# Чёрный список этого не давал: 03.09.2026 аудит нашёл в кандидатах на коммит
# живой профиль браузера `data/login_profile` (48 МБ, 509 файлов, cookies
# сессии hh.ru), резервную копию `hh_cookies.json.bak` и больше тысячи файлов
# с ФИО, телефоном, почтой и контактами третьих лиц.
# ============================================================

# ---- всё закрыто ----
/*

# ---- открыт инструментарий и документация ----
!/.gitignore
!/.github/
!/.pre-commit-config.yaml
!/LICENSE
!/README.md
!/pyproject.toml
!/setup.ps1
!/setup.sh
!/LINKEDIN_POSTS.md
!/LINKEDIN_POST_V4.md
!/agent/
!/config/
!/docs/
!/hh/
!/li-tools/
!/tg-bridge/
!/tools/

# ---- внутри открытых каталогов: только переиспользуемый код ----

# config: публикуется только шаблон, но не заполненный конфиг
/config/*
!/config/config.example.json

# tg-bridge: публикуется только бот, но не очередь входящих и не состояние
/tg-bridge/*
!/tg-bridge/tg_bot.py

# li-tools: публикуются постоянные li_*.py.
# Разовое (с датой в имени), пробы, дампы и скриншоты - мимо.
/li-tools/_*
/li-tools/*_20[0-9][0-9]-*
/li-tools/connect_*
/li-tools/debug_*
/li-tools/view_post*
/li-tools/probe_*
/li-tools/msg_*
/li-tools/*.png
/li-tools/*.jpg
/li-tools/*.json
/li-tools/*.txt

# ============================================================
# ДОСТУПЫ - не публикуются никогда, даже если попадут в открытый каталог
# ============================================================
config.local.json
config/config.local.json
*_cookies.json
*_cookies.json.bak
*.bak
.env
*.pem
*.key

# Профили браузера = живые cookies сессии. Публикация профиля равна выдаче
# доступа к аккаунтам hh.ru и LinkedIn.
data/
li_profile/
chrome_profile/
login_profile/
**/chrome_profile/
**/login_profile/
*_profile/
*.sqlite
Cookies
Cookies-journal

# ============================================================
# ЛИЧНЫЕ ДАННЫЕ - кандидата и третьих лиц (рекрутеров, работодателей)
# ============================================================
cover_letters/
cover_*.txt
cover_*.html
ats_html/
answers/
answers_*.json
applications_*.md
shortlist*
BOOKMAKERS_*.md
PROJECT_STATUS.md
TG_POSTS.md
LINKEDIN_POST.md
hr-outreach/
assets/
*.pdf
*.png
*.jpg
*.jpeg
tg_inbox.jsonl
tg-bridge/tg_inbox.jsonl
tg_offset_poll.txt
tg-bridge/tg_group_state.json
_audit_report.txt

# ============================================================
# Мусор сборки и среды
# ============================================================
__pycache__/
*.pyc
*.egg-info/
dist/
build/
venv/
.venv/
*.exe
*.log
*.jsonl
.DS_Store
Thumbs.db
.vscode/
.idea/

# личные данные владельца: ФИО, телефон, телеграм, id резюме, работодатель
agent/owner.local.md
*.local.md
